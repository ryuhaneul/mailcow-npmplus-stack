# === Required ===
DOMAIN=example.com
# Server IP (auto-detected if empty)
SERVER_IP=

# === NPMplus Admin ===
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=ChangeMe!Str0ng
# Existing IP-only NPM list for both admin hosts. Empty keeps existing access settings; new installs are public.
ADMIN_ACCESS_LIST=

# === CrowdSec ===
# Auto-generated by setup.sh if empty
CROWDSEC_BOUNCER_KEY=
# Enabled by default even when missing. Set false to remove stack-managed WAF rules.
WAF_ENABLE=true
# block = reject attacks; detect = pass requests and record alerts (tuning only).
WAF_MODE=block
# Comma-separated IPs/CIDRs exempt from IP ban decisions; AppSec still returns 403.
WAF_ALLOWLIST=

# === Mailcow Toolkit ===
# Keep installation/update enabled until the separate Toolkit removal step.
TOOLKIT_ENABLE=true
# Auto-generated by setup.sh if empty
MAILCOW_API_KEY=
TOOLKIT_SECRET_KEY=

# === Storage ===
# Optional: bind mailcow's vmail volume to a host path (e.g. a mergerfs pool).
# Leave empty to use the default Docker named volume (under /var/lib/docker).
VMAIL_DEVICE=

# === Optional Webmail ===
# Keep SnappyMail enabled until a separate cutover is approved.
WEBMAIL_ENABLE=false
SNAPPYMAIL_ENABLE=true
# Comma-separated hostnames. Empty uses newmail.${DOMAIN}; first is primary.
# Webmail enabled + SnappyMail disabled also adds mail.${DOMAIN} for routing/Origin.
WEBMAIL_HOSTNAMES=
# NPM access-list name (IP entries only). Empty means public access.
WEBMAIL_ACCESS_LIST=
# Brand name, optional organization name, and optional one/two-character mark.
WEBMAIL_BRAND_NAME=메일
WEBMAIL_ORG_NAME=
WEBMAIL_BRAND_MARK=
# Theme: ink, seland, terra, amber, olive. Mode: system, light, dark.
WEBMAIL_DEFAULT_THEME=ink
WEBMAIL_DEFAULT_MODE=system
# Forwarding: empty discovers active mailcow domains and alias domains automatically.
# Autocomplete: own domain plus this list; empty limits it to the own domain.
WEBMAIL_INTERNAL_DOMAINS=
# Address autocomplete (including recent recipients): true or false; missing defaults to true.
WEBMAIL_CONTACTS_ENABLE=true
# Additional AllMail exclusions, comma-separated mailbox names.
WEBMAIL_ALLMAIL_EXCLUDE=
# Total attachment limit (MiB), idle timeout (minutes), absolute timeout (hours).
WEBMAIL_ATTACH_MAX_MB=25
WEBMAIL_SESSION_IDLE_MIN=480
WEBMAIL_SESSION_MAX_HOURS=24
# Deprecated: WEBMAIL_IPV4 is no longer used after edge migration.
# Webmail leaves the mailcow network; use WEBMAIL_RELAY_IPV4 for its relay.
# App deployment overrides attach webmail only to its private edge network.
# WEBMAIL_IPV4=
# Relay source IPs inside mailcow's /24; empty uses <IPV4_NETWORK>.240 / .239.
WEBMAIL_RELAY_IPV4=
SNAPPYMAIL_RELAY_IPV4=
# Private RFC1918 edge networks, /24 through /29. Setup/update reject overlapping subnets.
WEBMAIL_EDGE_SUBNET=172.22.10.0/24
SNAPPYMAIL_EDGE_SUBNET=172.22.11.0/24
# NPMplus on the webmail edge (.2) is trusted by default; list extra proxies in front of it only.
WEBMAIL_TRUSTED_PROXIES=
# verify = normal certificate validation; pin = trust the current public leaf cert.
# TLS names come from mailcow.conf MAILCOW_HOSTNAME for mail protocols and the UI.
WEBMAIL_MAIL_TLS_MODE=verify
# Empty generates a random 32-character password and saves it in the stack .env.
WEBMAIL_DB_PASSWORD=

# === Webmail administration (opt in; requires WEBMAIL_ENABLE=true) ===
WEBMAIL_ADMIN_ENABLE=false
# Empty uses mailadmin.${DOMAIN}; must differ from mail/mailcow/mail-npm and Webmail hosts.
# Uses the existing ADMIN_ACCESS_LIST IP restriction.
WEBMAIL_ADMIN_HOSTNAME=
# Idle minutes: 1..180. Maximum hours must cover the idle timeout.
WEBMAIL_ADMIN_SESSION_IDLE_MIN=60
WEBMAIL_ADMIN_SESSION_MAX_HOURS=8

# === Junk/Trash retention (all mail clients; independent of Webmail) ===
MAIL_AUTOEXPUNGE_ENABLE=false
# Opt in per server with MAIL_AUTOEXPUNGE_ENABLE=true after notifying users.
# Missing selection keys stay disabled; setup/update never rewrite selections.
# Retention is an integer 1..365. Warn users before shortening it.
MAIL_AUTOEXPUNGE_DAYS=30

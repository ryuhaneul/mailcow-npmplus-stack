{
  "name": "mailstack-webmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "vite build web --outDir dist",
    "test": "node --test test/unit/*.test.js",
    "test:int": "node --test test/int/*.test.js",
    "e2e": "playwright test test/e2e",
    "check": "bash bin/check-npm-rules.sh && bash bin/check-generic.sh"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.6",
    "imapflow": "2.4.2",
    "nodemailer": "10.1.1",
    "dompurify": "3.4.17",
    "jsdom": "30.1.2",
    "iconv-lite": "0.7.3",
    "libmime": "5.4.8",
    "mysql2": "3.24.6",
    "preact": "10.29.8",
    "@preact/signals": "2.11.3",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@preact/preset-vite": "2.10.6",
    "smtp-server": "3.19.22",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.13.0"
  }
}
